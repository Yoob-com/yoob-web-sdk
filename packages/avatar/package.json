{
  "name": "@yoob/avatar",
  "version": "0.2.1",
  "description": "Talking characters rendered in the browser with WebGPU. Speech in, face out.",
  "license": "Apache-2.0",
  "homepage": "https://yoob.com/docs/web/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoob-com/yoob-web-sdk.git",
    "directory": "packages/avatar"
  },
  "keywords": [
    "avatar",
    "talking-head",
    "lip-sync",
    "webgpu",
    "realtime",
    "conversational-ai",
    "livekit"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./livekit": {
      "types": "./dist/livekit.d.ts",
      "import": "./dist/livekit.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm test && npm run build",
    "prebuild": "node scripts/pin-ort-gpu-buffers.mjs"
  },
  "peerDependencies": {
    "livekit-client": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.14",
    "@webgpu/types": "^0.1.66",
    "livekit-client": "2.22.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "onnxruntime-web": "1.27.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
